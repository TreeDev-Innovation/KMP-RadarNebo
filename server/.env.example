# Copy to server/.env (git-ignored) and fill in. `./gradlew :server:run` loads it;
# variables already set in the environment take precedence. See README → Running.

# alerts.in.ua token (https://devs.alerts.in.ua/). Leave empty to run the simulation.
ALERTS_API_TOKEN=

# Comma-separated keys clients must send. Leave empty for an open server.
CLIENT_KEYS=

# true logs every alerts.in.ua request and response (JSON body included, token masked).
LOG_HTTP=
